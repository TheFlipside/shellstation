{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellStation",
  "version": "0.30.0",
  "identifier": "com.luminaapps.shellstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShellStation",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/TheFlipside/shellstation/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNzJEMTc3NjlGMkQ5OUQKUldTZDJmSnBkOUZ5dXpKQWpHN0h2Zk9XaTdYM1NGMUhpQlJjTXIrcnVOOHI2bmZYdmhrRFp2V00K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
